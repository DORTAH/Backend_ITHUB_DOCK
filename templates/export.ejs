<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Экспорт документов</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="page-shell">
      <section class="upload-card export-card" aria-labelledby="page-title">
        <p class="eyebrow">IThub · документы</p>
        <h1 id="page-title">Экспорт документов</h1>

        <form id="export-form">
          <label class="field-label" for="document">Документ</label>
          <select id="document">
            <option value="discipline-register">Ведомость по дисциплине, предмету.xlsx</option>
          </select>

          <label class="field-label" for="semester">Семестр</label>
          <select id="semester" name="semesterNumber" required><option value="">Загрузка…</option></select>

          <label class="field-label" for="group">Учебная группа</label>
          <select id="group" name="groupId" required><option value="">Загрузка…</option></select>

          <label class="field-label" for="discipline">Дисциплина</label>
          <select id="discipline" name="disciplineId" required><option value="">Загрузка…</option></select>

          <label class="field-label" for="student" hidden>Студент</label>
          <select id="student" name="studentId" hidden disabled><option value="">Выберите группу и семестр</option></select>

          <label class="field-label" for="specialty">Специальность</label>
          <input id="specialty" name="specialty" type="text" placeholder="Подтянется из данных группы, если настроено">

          <label class="field-label" for="qualification">Квалификация</label>
          <input id="qualification" name="qualification" type="text" placeholder="Подтянется из данных группы, если настроено">

          <label class="field-label" for="control-form">Форма контроля</label>
          <select id="control-form" name="controlForm" required>
            <option value="">Выберите форму контроля</option>
            <option>Зачёт</option>
            <option>Дифференцированный зачёт</option>
            <option>Экзамен</option>
            <option>Контрольная работа</option>
          </select>

          <label class="field-label" for="date">Дата проведения</label>
          <input id="date" name="date" type="text" placeholder="ДД.ММ.ГГГГ (необязательно)">

          <label class="field-label" for="teacher">Преподаватель</label>
          <input id="teacher" name="teacher" type="text" placeholder="Оставьте пустым, чтобы взять из выгрузки">

          <button id="export-button" type="submit">Скачать документ</button>
        </form>

        <div id="result" class="result" role="status" aria-live="polite" hidden></div>
        <nav class="page-links"><a href="/">← К импорту</a></nav>
      </section>
    </main>

    <script>
      const form = document.getElementById('export-form');
      const result = document.getElementById('result');
      const button = document.getElementById('export-button');
      const template = document.getElementById('document');
      const student = document.getElementById('student');
      const groupSelect = document.getElementById('group');
      const semesterSelect = document.getElementById('semester');
      let groupsById = new Map();
      let studentsRequest = 0;

      function showField(id, visible) {
        const field = document.getElementById(id);
        field.hidden = !visible;
        field.disabled = !visible;
        document.querySelector(`label[for="${id}"]`).hidden = !visible;
      }

      async function loadStudents() {
        const request = ++studentsRequest;
        const personal = template.selectedOptions[0].dataset.personal === 'true';
        showField('student', personal);
        fillSelect(student, [], 'Выберите группу и семестр');
        if (!personal || !groupSelect.value || !semesterSelect.value) return;
        const query = new URLSearchParams({ groupId: groupSelect.value, semesterNumber: semesterSelect.value });
        try {
          const response = await fetch(`/api/export/document-students?${query}`);
          const items = await response.json();
          if (request !== studentsRequest) return;
          if (!response.ok) throw new Error(items.error || 'Не удалось получить список студентов');
          fillSelect(student, items, 'Выберите студента');
        } catch (error) {
          if (request === studentsRequest) showError(error.message);
        }
      }

      function updateFields() {
        const subjectRegister = template.value === 'discipline-register';
        for (const id of ['specialty', 'qualification', 'control-form', 'date', 'teacher']) {
          showField(id, subjectRegister);
        }
        for (const id of ['semester', 'group', 'discipline', 'control-form']) {
          document.getElementById(id).required = subjectRegister;
        }
        loadStudents();
      }

      function fillSelect(element, items, placeholder) {
        element.replaceChildren(new Option(placeholder, ''));
        for (const item of items) element.add(new Option(item.label ?? item.name, item.id));
        element.disabled = items.length === 0;
      }

      async function loadOptions() {
        const response = await fetch('/api/export/options');
        const options = await response.json();
        if (!response.ok) throw new Error(options.error || 'Не удалось получить данные для экспорта');
        groupsById = new Map(options.groups.map((group) => [String(group.id), group]));
        fillSelect(document.getElementById('semester'), options.semesters, 'Выберите семестр');
        fillSelect(document.getElementById('group'), options.groups, 'Выберите группу');
        fillSelect(document.getElementById('discipline'), options.disciplines, 'Выберите дисциплину');
      }

      function showError(message) {
        result.hidden = false;
        result.className = 'result result-error';
        result.textContent = message;
      }

      loadOptions().catch((error) => showError(error.message || 'Ошибка загрузки справочников'));

      fetch('/api/export/documents').then(async (response) => {
        if (!response.ok) throw new Error('Не удалось получить список документов');
        for (const { id, filename, personal } of await response.json()) {
          const option = new Option(filename, id);
          option.dataset.personal = String(personal);
          template.add(option);
        }
      }).catch((error) => showError(error.message));

      template.addEventListener('change', updateFields);
      semesterSelect.addEventListener('change', loadStudents);
      groupSelect.addEventListener('change', (event) => {
        const group = groupsById.get(event.currentTarget.value);
        document.getElementById('specialty').value = group?.specialty || '';
        document.getElementById('qualification').value = group?.qualification || '';
        loadStudents();
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        button.disabled = true;
        button.textContent = 'Формируем…';
        result.hidden = true;

        try {
          const payload = Object.fromEntries(new FormData(form));
          const endpoint = template.value === 'discipline-register'
            ? '/api/export/discipline-register'
            : `/api/export/documents/${encodeURIComponent(template.value)}`;
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.error || 'Не удалось сформировать ведомость');
          }

          const filenameHeader = response.headers.get('Content-Disposition') || '';
          const encodedName = filenameHeader.match(/filename\*=UTF-8''([^;]+)/i)?.[1];
          const filename = encodedName ? decodeURIComponent(encodedName) : template.selectedOptions[0].text;
          const url = URL.createObjectURL(await response.blob());
          const link = document.createElement('a');
          link.href = url;
          link.download = filename;
          link.click();
          URL.revokeObjectURL(url);

          result.hidden = false;
          result.className = 'result result-success';
          result.textContent = 'Документ сформирован и скачан.';
        } catch (error) {
          showError(error.message || 'Ошибка экспорта');
        } finally {
          button.disabled = false;
          button.textContent = 'Скачать документ';
        }
      });
    </script>
  </body>
</html>

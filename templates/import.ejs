<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Импорт успеваемости</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="page-shell">
      <section class="upload-card" aria-labelledby="page-title">
        <p class="eyebrow">IThub · отчёты</p>
        <h1 id="page-title">Импорт успеваемости</h1>
        <p class="intro">Загрузите Excel-отчёт в формате .xlsx. Строки будут добавлены в базу отдельной партией.</p>

        <form id="upload-form" action="/api/import/excel" method="post" enctype="multipart/form-data">
          <label class="file-picker" for="file-input">
            <span class="file-icon" aria-hidden="true">↑</span>
            <span class="file-copy">
              <strong id="file-name">Выберите Excel-файл</strong>
              <span>Формат .xlsx</span>
            </span>
            <input id="file-input" name="file" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required>
          </label>

          <button id="submit-button" type="submit">Загрузить и импортировать</button>
        </form>

        <div id="result" class="result" role="status" aria-live="polite" hidden></div>
        <p class="privacy-note">Файл обрабатывается на сервере и удаляется после завершения импорта.</p>
      </section>
    </main>

    <script>
      const form = document.getElementById('upload-form');
      const input = document.getElementById('file-input');
      const name = document.getElementById('file-name');
      const button = document.getElementById('submit-button');
      const result = document.getElementById('result');

      input.addEventListener('change', () => {
        name.textContent = input.files[0]?.name || 'Выберите Excel-файл';
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!input.files.length) return;

        button.disabled = true;
        button.textContent = 'Импортируем…';
        result.hidden = false;
        result.className = 'result result-pending';
        result.textContent = 'Загружаем файл и проверяем строки отчёта.';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
          });
          const payload = await response.json();

          if (!response.ok) throw new Error(payload.error || 'Не удалось импортировать файл');

          result.className = 'result result-success';
          result.textContent = `Импорт завершён: ${payload.importedRows} строк · ${payload.semester} · ${payload.sourceFileName}`;
          form.reset();
          name.textContent = 'Выберите Excel-файл';
        } catch (error) {
          result.className = 'result result-error';
          result.textContent = error.message || 'Ошибка при импорте файла';
        } finally {
          button.disabled = false;
          button.textContent = 'Загрузить и импортировать';
        }
      });
    </script>
  </body>
</html>

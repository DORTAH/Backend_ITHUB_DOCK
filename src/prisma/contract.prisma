// use prisma-8

model ImportBatch {
  id             Int                    @id @default(autoincrement())
  sourceFileName String
  semester       String?
  rowCount       Int                    @default(0)
  importedAt     DateTime               @default(now()) @onCreate(now())
  records        AcademicPerformance[]

  @@index([semester, importedAt])
  @@map("import_batches")
}

model Organization {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  suborganizations Suborganization[]
  records          AcademicPerformance[]

  @@map("organizations")
}

model Suborganization {
  id             Int               @id @default(autoincrement())
  name           String
  organizationId Int
  organization   Organization      @relation(fields: [organizationId], references: [id])
  records        AcademicPerformance[]
  studyGroups    StudyGroup[]
  disciplines    Discipline[]
  studyPrograms  StudyProgram[]

  @@unique([organizationId, name])
  @@map("suborganizations")
}

model Student {
  id          Int                    @id @default(autoincrement())
  email       String                 @unique
  lastName    String
  firstName   String
  patronymic String?
  admissionBase Int?
  admissionYear Int?
  records     AcademicPerformance[]
  licenseAssignments StudentLicense[]
  enrollments StudentEnrollment[]
  grades      StudentDisciplineGrade[]

  @@check(expression: sql`"admissionBase" IN (9, 11)`, name: "student_admission_base")
  @@map("students")
}

model StudyGroup {
  id                 Int                    @id @default(autoincrement())
  name               String
  suborganizationId  Int                    @map("suborganization_id")
  studyProgramId     Int?                   @map("study_program_id")
  studyPlanId        Int?                   @map("study_plan_id")
  
  suborganization    Suborganization        @relation(fields: [suborganizationId], references: [id])
  studyProgram       StudyProgram?          @relation(fields: [studyProgramId], references: [id])
  studyPlan          StudyPlan?             @relation(fields: [studyPlanId], references: [id])
  
  records            AcademicPerformance[]
  attestationCommissions AttestationCommission[]
  studentEnrollments StudentEnrollment[]
  planSemesters       StudyGroupPlanSemester[]

  @@unique([suborganizationId, name])
  @@map("study_groups")
}

model StudyProgram {
  id                 Int                    @id @default(autoincrement())
  specialtyCode      String
  name               String
  qualification      String
  suborganizationId  Int
  suborganization    Suborganization        @relation(fields: [suborganizationId], references: [id])
  groups             StudyGroup[]
  fgosDisciplines    FgosDiscipline[]
  attestationCommissions AttestationCommission[]
  studyPlans         StudyPlan[]

  @@unique([suborganizationId, specialtyCode])
  @@map("study_programs")
}

model Discipline {
  id                 Int                    @id @default(autoincrement())
  code               String
  name               String
  suborganizationId  Int
  suborganization    Suborganization        @relation(fields: [suborganizationId], references: [id])
  records            AcademicPerformance[]
  fgosMappings       FgosDisciplineMapping[]
  attestationCommissions AttestationCommission[]
  teachingAssignments EmployeeDisciplineAssignment[]
  studentGrades       StudentDisciplineGrade[]

  @@unique([suborganizationId, code, name])
  @@map("disciplines")
}

model FgosDiscipline {
  id             Int                    @id @default(autoincrement())
  studyProgramId Int
  code           String
  name           String
  studyProgram   StudyProgram           @relation(fields: [studyProgramId], references: [id])
  mappings       FgosDisciplineMapping[]
  studyPlanDisciplines StudyPlanDiscipline[]

  @@unique([studyProgramId, code, name])
  @@map("fgos_disciplines")
}

model FgosDisciplineMapping {
  id               Int            @id @default(autoincrement())
  disciplineId     Int
  fgosDisciplineId Int
  discipline       Discipline     @relation(fields: [disciplineId], references: [id])
  fgosDiscipline   FgosDiscipline @relation(fields: [fgosDisciplineId], references: [id])

  @@unique([disciplineId, fgosDisciplineId])
  @@map("fgos_discipline_mappings")
}

// Учебный план уникален для программы и года/базы поступления.
// Для поступивших после 9 класса обычно 8 семестров, после 11 класса — 6.
model StudyPlan {
  id             Int                  @id @default(autoincrement())
  studyProgramId Int
  admissionBase  Int
  admissionYear  Int
  name           String?
  sourceFileName String?
  studyProgram   StudyProgram         @relation(fields: [studyProgramId], references: [id])
  groups         StudyGroup[]
  disciplines    StudyPlanDiscipline[]

  @@unique([studyProgramId, admissionBase, admissionYear], map: "study_plan_program_cohort_key")
  @@check(expression: sql`"admissionBase" IN (9, 11)`, name: "study_plan_admission_base")
  @@map("study_plans")
}

// Связка группы с календарным периодом и номером семестра в её учебном плане.
model StudyGroupPlanSemester {
  id             Int        @id @default(autoincrement())
  studyGroupId   Int
  semesterLabel  String
  academicYear   String?
  semesterNumber Int
  studyGroup     StudyGroup @relation(fields: [studyGroupId], references: [id])

  @@unique([studyGroupId, semesterLabel], map: "group_plan_calendar_semester_key")
  @@map("study_group_plan_semesters")
}

model StudyPlanDiscipline {
  id               Int            @id @default(autoincrement())
  studyPlanId      Int
  fgosDisciplineId Int
  semesterNumber   Int
  controlForm      String?
  plannedHours     Int?
  studyPlan        StudyPlan      @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  fgosDiscipline   FgosDiscipline @relation(fields: [fgosDisciplineId], references: [id])

  @@index([studyPlanId, semesterNumber], map: "study_plan_discipline_term_idx")
  @@map("study_plan_disciplines")
}

// Состав комиссии для ведомости/документа за конкретный период и группу.
// Привязка к дисциплине необязательна: комиссия может быть общей для группы.
model AttestationCommission {
  id             Int                         @id @default(autoincrement())
  studyProgramId Int
  studyGroupId   Int?
  disciplineId   Int?
  academicYear   String?
  semesterNumber Int?
  semesterLabel  String?
  studyProgram   StudyProgram                @relation(fields: [studyProgramId], references: [id])
  studyGroup     StudyGroup?                 @relation(fields: [studyGroupId], references: [id])
  discipline     Discipline?                 @relation(fields: [disciplineId], references: [id])
  members        AttestationCommissionMember[]

  @@index([studyProgramId, academicYear, semesterNumber], map: "att_comm_prog_term_idx")
  @@index([studyGroupId, academicYear, semesterNumber], map: "att_comm_group_term_idx")
  @@map("attestation_commissions")
}

model AttestationCommissionMember {
  id           Int                   @id @default(autoincrement())
  commissionId Int
  fullName     String
  role         String
  position     String?
  sortOrder    Int                   @default(0)
  commission   AttestationCommission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId, sortOrder], map: "att_comm_member_order_idx")
  @@map("attestation_commission_members")
}

model Employee {
  id                  Int                           @id @default(autoincrement())
  fullName            String
  positions           EmployeePosition[]
  teachingAssignments EmployeeDisciplineAssignment[]
  issuedGrades        StudentDisciplineGrade[]

  @@map("employees")
}

model EmployeePosition {
  id         Int      @id @default(autoincrement())
  employeeId Int
  title      String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, title], map: "employee_position_key")
  @@map("employee_positions")
}

model EmployeeDisciplineAssignment {
  id                  Int                @id @default(autoincrement())
  employeeId          Int
  disciplineId        Int
  academicYear        Int?
  semesterNumber      Int?
  semesterLabel       String?
  employee            Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  discipline          Discipline         @relation(fields: [disciplineId], references: [id])

  @@index([disciplineId, semesterNumber], map: "employee_discipline_term_idx")
  @@index([employeeId, academicYear, semesterNumber], map: "employee_year_term_idx")
  @@index([disciplineId, academicYear], map: "employee_discipline_year_idx")
  @@map("employee_discipline_assignments")
}

model License {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  assignments StudentLicense[]

  @@map("licenses")
}

model StudentLicense {
  id         Int      @id @default(autoincrement())
  studentId  Int
  licenseId  Int
  student    Student  @relation(fields: [studentId], references: [id])
  license    License  @relation(fields: [licenseId], references: [id])
  history    StudentLicenseHistory[]

  @@map("student_licenses")
}

model StudentLicenseHistory {
  id                 Int           @id @default(autoincrement())
  studentLicenseId   Int
  semesterLabel      String
  academicYear       String?
  semesterNumber     Int?
  studentLicense     StudentLicense @relation(fields: [studentLicenseId], references: [id])

  @@index([studentLicenseId, academicYear, semesterNumber], map: "student_license_history_term_idx")
  @@map("student_license_history")
}

// История обучения студента в группе за каждый семестр.
// Курс и учебный год nullable: исходные Excel-выгрузки их явно не содержат.
model StudentEnrollment {
  id            Int        @id @default(autoincrement())
  studentId     Int
  studyGroupId  Int
  semesterLabel String
  semesterNumber Int?
  academicYear  String?
  courseNumber  Int?
  student       Student    @relation(fields: [studentId], references: [id])
  studyGroup    StudyGroup @relation(fields: [studyGroupId], references: [id])

  @@unique([studentId, semesterLabel], map: "student_enrollment_student_semester_key")
  @@index([studyGroupId, academicYear, semesterNumber], map: "student_enrollment_group_term_idx")
  @@map("student_enrollments")
}

model AcademicPerformance {
  id                           Int         @id @default(autoincrement())
  importBatchId                Int
  sourceRowNumber              Int
  organizationId               Int
  suborganizationId            Int
  semesterId                   Int
  studentId                    Int
  studyGroupId                 Int
  disciplineId                 Int
  teachersWhoGraded            String?
  teachersFromWorkload         String?
  allDisciplineTeachers        String?
  maxDisciplinePoints          Int
  maxPointsByTopics            Int
  availableControlPoints       Int
  taskAndTestPoints            Int
  currentPointsFivePointScale  Int
  retakePoints                 Int?
  retakePointsNew              Int?
  finalPoints                  Int
  finalPointsFivePointScale    Int
  currentDisciplinePercent     String?
  currentStudentAveragePercent String?
  maxAvailableControlPoints    Int
  importBatch                  ImportBatch    @relation(fields: [importBatchId], references: [id])
  organizationRef              Organization    @relation(fields: [organizationId], references: [id])
  suborganizationRef           Suborganization @relation(fields: [suborganizationId], references: [id])
  student                      Student         @relation(fields: [studentId], references: [id])
  studyGroup                   StudyGroup      @relation(fields: [studyGroupId], references: [id])
  discipline                   Discipline      @relation(fields: [disciplineId], references: [id])
  studentDisciplineGrades      StudentDisciplineGrade[]

  @@unique([importBatchId, sourceRowNumber], map: "ap_batch_row_key")
  @@index([studentId, semesterId], map: "ap_student_semester_idx")
  @@index([disciplineId, semesterId], map: "ap_discipline_semester_idx")
  @@map("academic_performance_records")
}

model StudentDisciplineGrade {
  id                    Int                 @id @default(autoincrement())
  studentId             Int
  disciplineId          Int
  employeeId            Int
  grade                 String
  semesterNumber        Int
  admissionYear         Int
  date                  DateTime
  academicPerformanceId Int?
  student               Student             @relation(fields: [studentId], references: [id])
  discipline            Discipline          @relation(fields: [disciplineId], references: [id])
  employee              Employee            @relation(fields: [employeeId], references: [id])
  academicPerformance   AcademicPerformance? @relation(fields: [academicPerformanceId], references: [id])

  @@index([studentId, admissionYear, semesterNumber], map: "student_grade_student_term_idx")
  @@index([disciplineId, admissionYear, semesterNumber], map: "student_grade_discipline_term_idx")
  @@index([academicPerformanceId], map: "student_grade_performance_idx")
  @@map("student_discipline_grades")
}
